# Use the official rubygems.org source so CI (GitHub Actions, overseas runners) can fetch specs.
# For fast installs on a China network, set a local mirror instead of changing this line:
#   bundle config mirror.https://rubygems.org https://gems.ruby-china.com
# (that writes to .bundle/config, which is gitignored, and does not affect CI)
source "https://rubygems.org/"

gem "jekyll"
gem "jekyll-paginate"
gem "jekyll-sitemap"
gem "jekyll-pdf-embed"
gem "jekyll-feed"

# Node.js 22+ compatibility
gem "webrick"

gem "tzinfo", "~> 2.0"

gem "tzinfo-data", "~> 1.2026"
